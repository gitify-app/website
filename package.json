{
  "name": "gitify-website",
  "version": "latest",
  "private": true,
  "description": "The source code of gitify.io",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 node --test \"src/**/*.test.ts\"",
    "preview": "astro preview",
    "prepare": "husky",
    "astro": "astro",
    "lint:check": "biome check",
    "lint": "biome check --fix"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitify-app/website"
  },
  "keywords": [
    "gitify",
    "github",
    "notifier",
    "notifications",
    "website",
    "astro"
  ],
  "author": {
    "name": "Emmanouil Konstantinidis",
    "email": "hello@manos.im"
  },
  "contributors": [
    {
      "name": "Emmanouil Konstantinidis",
      "url": "https://github.com/manosim"
    },
    {
      "name": "Adam Setch",
      "url": "https://github.com/setchy"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gitify-app/website/issues"
  },
  "homepage": "https://gitify.io",
  "dependencies": {
    "@iconify-json/line-md": "1.2.16",
    "@iconify-json/mdi": "1.2.3",
    "@octokit/openapi-types": "29.0.1",
    "@tailwindcss/vite": "4.3.3",
    "accessible-astro-components": "5.8.0",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "date-fns": "4.4.0",
    "marked": "18.1.0",
    "octokit": "5.0.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tailwindcss-motion": "1.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "c8": "12.0.0",
    "husky": "9.1.7",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,astro}": "biome format --fix"
  }
}
