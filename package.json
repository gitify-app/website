{
  "name": "gitify-website",
  "version": "latest",
  "private": true,
  "description": "The source code of gitify.io",
  "keywords": [
    "astro",
    "github",
    "gitify",
    "notifications",
    "notifier",
    "website"
  ],
  "homepage": "https://gitify.io",
  "bugs": {
    "url": "https://github.com/gitify-app/website/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Emmanouil Konstantinidis",
    "email": "hello@manos.im"
  },
  "contributors": [
    {
      "name": "Emmanouil Konstantinidis",
      "url": "https://github.com/manosim"
    },
    {
      "name": "Adam Setch",
      "url": "https://github.com/setchy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gitify-app/website"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "husky",
    "astro": "astro",
    "lint:check": "oxlint && oxfmt --check && prettier --check \"src/**/*.astro\"",
    "lint": "oxlint --fix && oxfmt && prettier --write \"src/**/*.astro\""
  },
  "dependencies": {
    "@iconify-json/line-md": "1.2.16",
    "@iconify-json/mdi": "1.2.3",
    "@octokit/openapi-types": "27.0.0",
    "@tailwindcss/vite": "4.3.3",
    "accessible-astro-components": "5.4.0",
    "astro": "7.1.3",
    "astro-icon": "1.1.5",
    "date-fns": "4.4.0",
    "marked": "18.0.7",
    "octokit": "5.0.5",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-motion": "1.1.1"
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "husky": "9.1.7",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,json,css,md}": "oxfmt",
    "*.astro": "prettier --write"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
