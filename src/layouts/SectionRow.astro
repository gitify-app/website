---
import { Image } from 'astro:assets';

import { marked } from 'marked';

export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  screenshot?: {
    path: string;
    alt: string;
  };
  isDark?: boolean;
  isReversed?: boolean;
}

const {
  eyebrow,
  title,
  description,
  screenshot,
  isReversed = false,
} = Astro.props;
---

<section class="relative py-20 lg:py-28">
  <div
    class="container max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center"
  >
    <div class:list={[isReversed && "lg:order-2"]}>
      {eyebrow && (
          <p class="font-mono text-sm text-gitify-accent-bright">{eyebrow}</p>
        )}
      <h2
        class="mt-3 font-display text-3xl lg:text-4xl font-semibold tracking-tight"
      >
        {title}
      </h2>
      <div
        class="mt-5 text-lg leading-relaxed text-gitify-muted [&_p]:mb-4 [&_p:last-child]:mb-0"
        set:html={marked(description)}
      />
    </div>

    {screenshot && (
        <div class:list={["relative", isReversed && "lg:order-1"]}>
          <div class="pointer-events-none absolute inset-8 rounded-full bg-gitify-accent/10 blur-[80px]" />
          <div class="relative overflow-hidden rounded-2xl border border-gitify-line bg-gitify-surface shadow-2xl shadow-black/60">
            <div class="flex items-center gap-1.5 border-b border-gitify-line px-4 py-3">
              <span class="size-3 rounded-full bg-[#FF5F57]" />
              <span class="size-3 rounded-full bg-[#FEBC2E]" />
              <span class="size-3 rounded-full bg-[#28C840]" />
              <span class="ml-3 font-mono text-xs text-gitify-muted">
                gitify
              </span>
            </div>
            <Image
              class="block w-full h-auto"
              width="500"
              height="400"
              src={import(`../assets/${screenshot.path}.png`)}
              alt={screenshot.alt}
            />
          </div>
        </div>
      )}

    <slot />
  </div>
</section>
