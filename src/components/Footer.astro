---
import { Icon } from 'astro-icon/components';

import { siteMetadata, URLs } from '~/constants';

import Logo from '~/components/Logo.astro';

const links = [
  { name: 'FAQ', path: '/faq/' },
  { name: 'Releases', path: URLs.GITHUB.LATEST_RELEASE },
  { name: 'Issues', path: URLs.GITHUB.ISSUES },
  { name: 'GitHub', path: URLs.GITHUB.REPO },
];
---

<footer class="mt-auto border-t border-gitify-line bg-gitify-surface/40">
  <div class="container max-w-6xl mx-auto px-6 py-12">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <div class="flex items-center gap-3">
        <Logo className="w-8" />
        <div>
          <div class="font-display font-semibold">{siteMetadata.title}</div>
          <div class="text-sm text-gitify-muted">
            {siteMetadata.description}.
          </div>
        </div>
      </div>

      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        {links.map((link) => (
            <li>
              <a
                href={link.path}
                class="text-gitify-muted transition-colors hover:text-gitify-text"
              >
                {link.name}
              </a>
            </li>
          ))}
        <li>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={URLs.GITHUB.REPO}
            aria-label="GitHub Repository"
            class="text-gitify-muted transition-colors hover:text-gitify-text"
          >
            <Icon name="mdi:github" size={20} />
          </a>
        </li>
      </ul>
    </div>

    <div
      class="mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-t border-gitify-line pt-6 font-mono text-xs text-gitify-muted"
    >
      <span>
        © {new Date().getFullYear()}{" "}
        <a
          href={siteMetadata.author.site}
          class="hover:text-gitify-text transition-colors"
        >
          {siteMetadata.author.name}
        </a>
      </span>
      <span>MIT Licensed · Free forever</span>
    </div>
  </div>
</footer>
