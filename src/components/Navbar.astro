---
import { siteMetadata } from '~/constants';

import GitHubRepo from '~/components/GitHubRepo.astro';
import Logo from '~/components/Logo.astro';

const { currentPathname } = Astro.props;
---

<nav
  class="sticky top-0 z-50 border-b border-gitify-line bg-gitify-ink/80 backdrop-blur-md"
>
  <div class="container max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between py-4">
      <a
        href="/"
        aria-label={siteMetadata.title}
        class="flex items-center gap-3 group"
      >
        <Logo className="w-8 transition-transform group-hover:scale-105" />
        <span class="font-display text-lg font-semibold tracking-tight">
          {siteMetadata.title}
        </span>
      </a>

      <ul class="flex flex-row items-center list-none gap-2 sm:gap-6">
        {
          siteMetadata.menuLinks.map((item) => (
            <li>
              <a
                href={item.path}
                class:list={[
                  'px-3 py-1.5 rounded-full text-sm transition-colors',
                  currentPathname === item.path
                    ? 'bg-gitify-raised text-gitify-text font-medium'
                    : 'text-gitify-muted hover:text-gitify-text',
                ]}
              >
                {item.name}
              </a>
            </li>
          ))
        }

        <li><GitHubRepo /></li>
      </ul>
    </div>
  </div>
</nav>
