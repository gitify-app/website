---
import { Image } from 'astro:assets';

import notifications from '~/assets/notifications.png';
import LatestRelease from '~/components/LatestRelease.astro';
---

<header class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
  ></div>
  <div
    class="pointer-events-none absolute -top-48 left-1/2 h-96 w-[64rem] -translate-x-1/2 rounded-full bg-gitify-accent/10 blur-[140px]"
  ></div>

  <div
    class="relative container max-w-6xl mx-auto px-6 pt-16 pb-20 lg:pt-24 lg:pb-28 grid lg:grid-cols-2 gap-16 items-center"
  >
    <div>
      <div
        class="inline-flex items-center gap-2 rounded-full border border-gitify-line bg-gitify-surface/60 px-3 py-1.5 font-mono text-xs text-gitify-muted"
      >
        <span
          class="size-1.5 rounded-full bg-gitify-accent motion-preset-pulse motion-duration-2000"
        ></span>
        Free &amp; open source · macOS, Windows &amp; Linux
      </div>

      <h1
        class="mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight"
      >
        Git notifications, right on your{" "}
        <span class="text-gitify-accent-bright">menu bar</span>.
      </h1>

      <p class="mt-6 max-w-md text-lg leading-relaxed text-gitify-muted">
        Gitify pulls every mention, review request and failing check out of your
        inbox and into one quiet, always-visible tray. Inbox zero, without the
        tab hoarding.
      </p>

      <LatestRelease />

      <div class="mt-6 flex items-center gap-3">
        <code
          class="rounded-lg border border-gitify-line bg-gitify-surface px-3 py-2 font-mono text-xs text-gitify-muted"
        >
          <span class="text-gitify-accent-bright">$</span>
          brew install --cask gitify
        </code>
      </div>
    </div>

    <div class="relative motion-preset-pop motion-duration-1000">
      <div
        class="pointer-events-none absolute inset-8 rounded-full bg-gitify-accent/20 blur-[80px]"
      ></div>
      <div
        class="relative overflow-hidden rounded-2xl border border-gitify-line bg-gitify-surface shadow-2xl shadow-black/60"
      >
        <div
          class="flex items-center gap-1.5 border-b border-gitify-line px-4 py-3"
        >
          <span class="size-3 rounded-full bg-[#FF5F57]"></span>
          <span class="size-3 rounded-full bg-[#FEBC2E]"></span>
          <span class="size-3 rounded-full bg-[#28C840]"></span>
          <span class="ml-3 font-mono text-xs text-gitify-muted">gitify</span>
        </div>
        <Image
          class="block w-full h-auto"
          src={notifications}
          alt="Gitify - Notifications"
          width="500"
          height="400"
        />
      </div>
    </div>
  </div>
</header>
