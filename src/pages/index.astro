---
import { Icon } from 'astro-icon/components';

import { URLs } from '~/constants';

import Hero from '~/components/Hero.astro';
import { openSourceLibs } from '~/icons/icons';
import Layout from '~/layouts/Layout.astro';
import SectionRow from '~/layouts/SectionRow.astro';
---

<Layout title="Git notifications on your menu bar">
  <main>
    <Hero />

    <SectionRow
      title="All your Git notifications, right on your desktop."
      description="<p>Gitify is all about making your life easier.</p><br /><p>Always visible on your menu bar, Gitify delivers real-time notifications across GitHub Cloud, GitHub Enterprise Cloud, GitHub Enterprise Server, Gitea (including Forgejo and Codeberg), GitLab (Cloud and Self-Managed), and Bitbucket Cloud.</p><br /><p>Stay on top of your work, effortlessly.</p>"
      screenshot={{
        path: 'all-read',
        alt: 'Screenshot of Gitify when all notifications are read',
      }}
      isReversed
      isDark
    />

    <SectionRow
      title="Cut through the noise, focus on what matters."
      description="<p>Inbox overflowing?</p><br /><p>Gitify helps you filter notifications so you can quickly zero in on what’s important.</p>"
      screenshot={{
        path: 'filters',
        alt: 'Screenshot for notification filters',
      }}
    />

    <SectionRow
      title="Your notifications, your way."
      description="<p>Gitify gives you full control: show native OS notifications, play a new notification sound (we promise it's not annoying), or change its appearance.</p><br /><p>It's designed to keep you informed without interrupting your workflow. Customize it to suit your style.</p>"
      screenshot={{
        path: 'settings',
        alt: 'Screenshot for user preferences, settings',
      }}
      isReversed
      isDark
    />

    <SectionRow
      title="Free & Open Source."
      description={`<p>Gitify is built with TypeScript, Electron, React, Tailwind CSS, Vite+, Primer, TanStack Query, Zustand, Octokit, and other open-source libraries.</p><br /><p>Free to use, <a href="${URLs.GITHUB.REPO}/blob/main/LICENSE">MIT-licensed</a>, and <a href="${URLs.GITHUB.REPO}/blob/main/CONTRIBUTING.md">open to contributions</a>.</p>`}
    >
      <ul
        class="grid grid-cols-3 gap-4 w-full max-w-xs shrink-0 mt-12 lg:mt-0"
        aria-label="Built with open-source libraries"
      >
        {openSourceLibs.map((item) => (
          <li>
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.name}
              title={item.name}
              class:list={[
                'icon flex items-center justify-center p-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gitify-navbar motion-safe:hover:motion-preset-pulse motion-safe:hover:motion-duration-1000',
                item.color ?? 'text-black',
              ]}
            >
              {item.image ? (
                <img
                  src={item.image}
                  width={48}
                  height={48}
                  class="size-8 sm:size-12 object-contain pointer-events-none"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Icon
                  name={item.svg}
                  size={48}
                  class="size-8 sm:size-12 pointer-events-none"
                  aria-hidden="true"
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    </SectionRow>
  </main>
</Layout>
