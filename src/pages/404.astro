---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <div
    class="container max-w-4xl mx-auto px-6 flex-1 flex flex-col items-center justify-center py-20 text-center"
  >
    <p class="font-mono text-sm text-gitify-accent-bright">404</p>
    <h1
      class="mt-3 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight"
    >
      Page Not Found
    </h1>
    <img
      class="mt-10 w-1/2 md:w-1/3 lg:w-1/4"
      src="/images/404.png"
      alt="404 Not Found"
    />
    <p class="mt-10 md:text-lg text-gitify-muted">
      Sorry, the page you are looking for could not be found.
    </p>
    <a
      href="/"
      class="mt-10 flex items-center gap-2 rounded-xl bg-gitify-accent px-5 py-3 text-sm font-semibold text-gitify-ink shadow-lg shadow-gitify-accent/20 transition-all hover:bg-gitify-accent-bright hover:-translate-y-0.5"
      title="Return Home"
    >
      <span>&#8592; Return Home</span>
    </a>
  </div>
</Layout>
